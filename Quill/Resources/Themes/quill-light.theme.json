{
  "name": "Quill Light",
  "type": "light",
  "colors": {
    "editor.background": "#FFFFFF",
    "editor.foreground": "#2E3440",
    "editorLineNumber.foreground": "#A0A4B0",
    "editorLineNumber.activeForeground": "#4C566A",
    "editor.lineHighlightBackground": "#F4F5F8",
    "editor.selectionBackground": "#CCD9FF",
    "editorCursor.foreground": "#2E3440",
    "editorBracketMatch.background": "#DCE2FF",
    "editor.findMatchBackground": "#F5B14C",
    "editor.findMatchHighlightBackground": "#FFE08A80"
  },
  "tokenColors": [
    { "scope": "comment", "settings": { "foreground": "#8A91A0", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage.type", "storage.modifier"], "settings": { "foreground": "#AF00DB" } },
    { "scope": "keyword.operator", "settings": { "foreground": "#0B7285" } },
    { "scope": "string", "settings": { "foreground": "#0F7B3A" } },
    { "scope": "constant.character.escape", "settings": { "foreground": "#0B7285" } },
    { "scope": "constant.numeric", "settings": { "foreground": "#B35C00" } },
    { "scope": ["constant.language", "support.constant"], "settings": { "foreground": "#B35C00" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#2F5FD0" } },
    { "scope": ["entity.name.type", "support.type", "entity.name.namespace"], "settings": { "foreground": "#B5452E" } },
    { "scope": "variable", "settings": { "foreground": "#2E3440" } },
    { "scope": "variable.parameter", "settings": { "foreground": "#8A4B00" } },
    { "scope": "variable.language", "settings": { "foreground": "#C7254E" } },
    { "scope": ["variable.other.property", "variable.other.member"], "settings": { "foreground": "#3B5B8C" } },
    { "scope": ["entity.other.attribute-name", "meta.attribute"], "settings": { "foreground": "#A24B00" } },
    { "scope": "entity.name.tag", "settings": { "foreground": "#B5452E" } },
    { "scope": "entity.name.label", "settings": { "foreground": "#8A4B00" } },
    { "scope": "punctuation", "settings": { "foreground": "#6B7280" } },
    { "scope": "markup.heading", "settings": { "foreground": "#2F5FD0", "fontStyle": "bold" } },
    { "scope": "markup.bold", "settings": { "fontStyle": "bold" } },
    { "scope": "markup.italic", "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.inline.raw", "markup.raw"], "settings": { "foreground": "#0F7B3A" } },
    { "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#0B7285", "fontStyle": "underline" } },
    { "scope": "markup.quote", "settings": { "foreground": "#5C6370", "fontStyle": "italic" } },
    { "scope": "punctuation.definition.list", "settings": { "foreground": "#AF00DB" } }
  ]
}

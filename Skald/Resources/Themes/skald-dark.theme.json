{
  "name": "Skald Dark",
  "type": "dark",
  "colors": {
    "editor.background": "#1E1F24",
    "editor.foreground": "#D4D7E0",
    "editorLineNumber.foreground": "#5C6070",
    "editorLineNumber.activeForeground": "#C8CCD6",
    "editor.lineHighlightBackground": "#262830",
    "editor.selectionBackground": "#3A3F55",
    "editorCursor.foreground": "#AEB7FF",
    "editorBracketMatch.background": "#4A5080",
    "editor.findMatchBackground": "#C2742A",
    "editor.findMatchHighlightBackground": "#7A5A2066"
  },
  "tokenColors": [
    { "scope": "comment", "settings": { "foreground": "#6B7280", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage.type", "storage.modifier"], "settings": { "foreground": "#C792EA" } },
    { "scope": "keyword.operator", "settings": { "foreground": "#89DDFF" } },
    { "scope": "string", "settings": { "foreground": "#C3E88D" } },
    { "scope": "constant.character.escape", "settings": { "foreground": "#89DDFF" } },
    { "scope": "constant.numeric", "settings": { "foreground": "#F78C6C" } },
    { "scope": ["constant.language", "support.constant"], "settings": { "foreground": "#FF9E64" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#82AAFF" } },
    { "scope": ["entity.name.type", "support.type", "entity.name.namespace"], "settings": { "foreground": "#FFCB6B" } },
    { "scope": "variable", "settings": { "foreground": "#D4D7E0" } },
    { "scope": "variable.parameter", "settings": { "foreground": "#F2A5A5" } },
    { "scope": "variable.language", "settings": { "foreground": "#FF5370" } },
    { "scope": ["variable.other.property", "variable.other.member"], "settings": { "foreground": "#B2CCD6" } },
    { "scope": ["entity.other.attribute-name", "meta.attribute"], "settings": { "foreground": "#FFD580" } },
    { "scope": "entity.name.tag", "settings": { "foreground": "#F07178" } },
    { "scope": "entity.name.label", "settings": { "foreground": "#F2A5A5" } },
    { "scope": "punctuation", "settings": { "foreground": "#8A90A5" } },
    { "scope": "markup.heading", "settings": { "foreground": "#82AAFF", "fontStyle": "bold" } },
    { "scope": "markup.bold", "settings": { "fontStyle": "bold" } },
    { "scope": "markup.italic", "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.inline.raw", "markup.raw"], "settings": { "foreground": "#C3E88D" } },
    { "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#89DDFF", "fontStyle": "underline" } },
    { "scope": "markup.quote", "settings": { "foreground": "#9AA0B4", "fontStyle": "italic" } },
    { "scope": "punctuation.definition.list", "settings": { "foreground": "#C792EA" } }
  ]
}
